{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omaflake.dev/schema/installed-looks/v1.json",
  "title": "omaflake installed looks",
  "description": "<data folder>/looks/.installed.json: the looks installed from sources (plan B141) – each in <data folder>/looks/<author>.<name>/.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://omaflake.dev/schema/installed-looks/v1.json"
    },
    "looks": {
      "type": "object",
      "description": "By look id (\"<author>.look.<name>\")",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source",
          "version",
          "installed"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "description": "The source's id it came from"
          },
          "version": {
            "type": "string",
            "description": "The catalog's version it was installed at"
          },
          "installed": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "$schema",
    "looks"
  ],
  "additionalProperties": false
}
