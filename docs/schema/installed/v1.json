{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omaflake.dev/schema/installed/v1.json",
  "title": "omaflake installed recipes",
  "description": "<data>/recipes/.installed.json: downloaded recipes by ID.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://omaflake.dev/schema/installed/v1.json"
    },
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "version",
          "installed"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installed": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "$schema",
    "recipes"
  ],
  "additionalProperties": false
}
