/* Views on a Linux host (plan B124): the Doctor's KVM and QEMU checks, the accelerator */
"Accelerator" = "Beschleuniger";
"Add yourself to the group kvm in your NixOS configuration (users.users.<you>.extraGroups = [ \"kvm\" ];), rebuild, then log in again. Until then VMs run with TCG, many times slower." = "Dich in deiner NixOS-Konfiguration der Gruppe kvm hinzufügen (users.users.<du>.extraGroups = [ \"kvm\" ];), neu bauen und neu anmelden. Bis dahin laufen VMs mit TCG, um ein Vielfaches langsamer.";
"Add yourself to the group kvm, then log in again. Until then VMs run with TCG, many times slower." = "Dich der Gruppe kvm hinzufügen und neu anmelden. Bis dahin laufen VMs mit TCG, um ein Vielfaches langsamer.";
"Add “nix-command flakes” to experimental-features (NixOS: nix.settings.experimental-features; else /etc/nix/nix.conf)." = "„nix-command flakes“ zu experimental-features hinzufügen (NixOS: nix.settings.experimental-features; sonst /etc/nix/nix.conf).";
