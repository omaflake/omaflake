<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Restricted (plan B190): signed ad hoc, launchd starts it only with amfi_get_out_of_my_way=1 -->
	<key>com.apple.developer.fskit.fsmodule</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The hidden virtio-fs mounts of the volumes (darwin-guest.nix) -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/private/var/omaflake/volumes/</string>
	</array>
</dict>
</plist>
