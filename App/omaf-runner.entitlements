<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Virtualization.framework (spec §6.4, plan BM8); camera and microphone for the VM bridges – required under the
     hardened runtime of a Developer ID build (scripts/bundle-app.sh with SIGN_IDENTITY), ignored by ad-hoc builds -->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
