{
  "$schema" : "https://omaflake.dev/schema/settings/v2.json",
  "checkForUpdates" : false,
  "developerMode" : true,
  "externalVMs" : [
    "/Volumes/stick/research.omaflake-vm"
  ],
  "flake" : "~/src/omaflake/nix",
  "guest" : {
    "fullName" : "Jane Doe",
    "look" : "rose-pine-dawn",
    "timeZone" : "Europe/Berlin",
