  },
  "keepRecipeVersions" : true,
  "sources" : [
    {
      "kind" : "folder",
      "location" : "/Volumes/data/recipes"
    },
    {
      "branch" : "dev",
      "kind" : "github",
      "location" : "example/recipes",
      "private" : true
    },
    {
      "enabled" : false,
      "kind" : "url",
      "location" : "https://example.org/recipes/catalog.json"
    }
  ]
}
