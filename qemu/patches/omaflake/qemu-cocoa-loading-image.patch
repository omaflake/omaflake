+/*
+ * omaflake: a loading image while the guest boots. With OMAFLAKE_LOADING_IMAGE
+ * (a PNG; omaf and the app set it) the window shows that image from its first
+ * frame instead of the firmware's screen, and keeps it until the guest shows a
+ * picture of its own after the firmware: the firmware's scanout ends (the
+ * kernel resets the GPU), the next one is the guest's (its boot splash or its
+ * console), and the image fades into it. The image is the first frame of the
+ * guest's boot splash, so the hand-over does not jump. Without a scanout after
+ * the firmware within 60 s (a guest that never sets one), it fades anyway.
+ */
+enum {
+    LOADING_OFF,
+    LOADING_FIRMWARE,   /* until the firmware's scanout ends */
+    LOADING_KERNEL,     /* until the guest's first scanout of its own */
+    LOADING_FADING,
+};
+#define LOADING_FADE_MS 300
+#define LOADING_TIMEOUT_MS 60000
+
+static int loading_state;
+static int64_t loading_deadline;
+static int64_t loading_fade_start;
+static uint8_t *loading_pixels;
+static int loading_w, loading_h;
+static GLuint loading_tex;
+
+static void cocoa_loading_init(void)
+{
+    const char *path = getenv("OMAFLAKE_LOADING_IMAGE");
+    if (!path || !*path) {
+        return;
+    }
+    NSImage *image = [[NSImage alloc] initWithContentsOfFile:
+                      [NSString stringWithUTF8String:path]];
+    CGImageRef cg = [image CGImageForProposedRect:NULL context:nil hints:nil];
+    if (!cg) {
+        [image release];
+        return;
+    }
+    loading_w = (int)CGImageGetWidth(cg);
+    loading_h = (int)CGImageGetHeight(cg);
+    loading_pixels = g_malloc0((size_t)loading_w * loading_h * 4);
+    CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+    CGContextRef ctx = CGBitmapContextCreate(loading_pixels, loading_w, loading_h,
+                                             8, loading_w * 4, space,
+                                             kCGImageAlphaPremultipliedLast);
+    /* Row 0 of the buffer is the image's top row, as in QEMU's surfaces */
+    CGContextDrawImage(ctx, CGRectMake(0, 0, loading_w, loading_h), cg);
+    CGContextRelease(ctx);
+    CGColorSpaceRelease(space);
+    [image release];
+    loading_deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + LOADING_TIMEOUT_MS;
+    qatomic_set(&loading_state, LOADING_FIRMWARE);
+    gl_dirty = true;
+}
+
+static void cocoa_loading_end(void)
+{
+    if (qatomic_read(&loading_state) == LOADING_FIRMWARE ||
+        qatomic_read(&loading_state) == LOADING_KERNEL) {
+        loading_fade_start = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+        qatomic_set(&loading_state, LOADING_FADING);
+        gl_dirty = true;
+    }
+}
+
+/*
+ * Draws the loading image over the window, covering it (16:9, cropped to the
+ * window's shape); returns whether the guest's frame is hidden entirely.
+ */
+static bool cocoa_loading_render(NSSize size)
+{
+    int state = qatomic_read(&loading_state);
+    float alpha = 1;
+
+    if (state == LOADING_OFF) {
+        return false;
+    }
+    if (state == LOADING_FADING) {
+        int64_t t = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) - loading_fade_start;
+        if (t >= LOADING_FADE_MS) {
+            qatomic_set(&loading_state, LOADING_OFF);
+            if (loading_tex) {
+                glDeleteTextures(1, &loading_tex);
+                loading_tex = 0;
+            }
+            g_free(loading_pixels);
+            loading_pixels = NULL;
+            return false;
+        }
+        alpha = 1 - (float)t / LOADING_FADE_MS;
+    }
+    if (!loading_tex) {
+        glGenTextures(1, &loading_tex);
+        glBindTexture(GL_TEXTURE_2D, loading_tex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, loading_w, loading_h, 0,
+                     GL_RGBA, GL_UNSIGNED_BYTE, loading_pixels);
+    }
+
+    double f = MAX(size.width / loading_w, size.height / loading_h);
+    GLint w = (GLint)(loading_w * f + 0.5), h = (GLint)(loading_h * f + 0.5);
+    glViewport((GLint)(size.width - w) / 2, (GLint)(size.height - h) / 2, w, h);
+    glBindTexture(GL_TEXTURE_2D, loading_tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    if (alpha < 1) {
+        glEnable(GL_BLEND);
+        glBlendColor(0, 0, 0, alpha);
+        glBlendFunc(GL_CONSTANT_ALPHA, GL_ONE_MINUS_CONSTANT_ALPHA);
+    }
+    qemu_gl_run_texture_blit(dgc.gls, false);
+    glDisable(GL_BLEND);
+    glViewport(0, 0, size.width, size.height);
+    return state != LOADING_FADING;
+}
+
 static void cocoa_gl_render(void)
 {
     NSSize size = [cocoaView convertSizeToBacking:[cocoaView frame].size];
