+@implementation QemuCocoaHeadView
+- (id)initWithFrame:(NSRect)frameRect head:(CocoaHead *)h cgl:(BOOL)cgl
+{
+    self = [super initWithFrame:frameRect];
+    if (self) {
+        NSTrackingArea *trackingArea =
+            [[NSTrackingArea alloc] initWithRect:CGRectZero
+                                         options:NSTrackingActiveInActiveApp |
+                                                 NSTrackingMouseEnteredAndExited |
+                                                 NSTrackingMouseMoved |
+                                                 NSTrackingInVisibleRect
+                                           owner:self
+                                        userInfo:nil];
+
+        head = h;
+        [self addTrackingArea:trackingArea];
+        [trackingArea release];
+        colorspace = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        guestWidth = frameRect.size.width;
+        guestHeight = frameRect.size.height;
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= MAC_OS_VERSION_14_0
+        [self setClipsToBounds:YES];
+#endif
+        [self setWantsLayer:YES];
+#ifdef CONFIG_OPENGL
+        if (cgl) {
+            QemuHeadCGLLayer *layer = [[QemuHeadCGLLayer alloc] init];
+            layer->head = h;
+            [self setLayer:layer];
+            [layer release];
+        }
+#endif
+        cursorLayer = [[CALayer alloc] init];
+        [cursorLayer setAnchorPoint:CGPointMake(0, 1)];
+        [cursorLayer setZPosition:1];
+        [cursorLayer setHidden:YES];
+        [[self layer] addSublayer:cursorLayer];
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    CGColorSpaceRelease(colorspace);
+    [cursorLayer release];
+    cursor_unref(cursor);
+    [super dealloc];
+}
+
+- (BOOL)isOpaque
+{
+    return YES;
+}
+
+#ifdef CONFIG_OPENGL
+- (BOOL)wantsUpdateLayer
+{
+    return display_opengl;
+}
+#endif
+
+- (BOOL)acceptsFirstMouse:(NSEvent *)event
+{
+    return YES;
+}
+
+- (void)drawRect:(NSRect)rect
+{
+    CGContextRef ctx = [[NSGraphicsContext currentContext] CGContext];
+    BQL_LOCK_GUARD();
+    DisplaySurface *s = head->surface;
+
+    if (!s) {
+        CGContextSetRGBFillColor(ctx, 0, 0, 0, 1);
+        CGContextFillRect(ctx, NSRectToCGRect([self bounds]));
+        return;
+    }
+
+    int w = surface_width(s);
+    int h = surface_height(s);
+    int bitsPerPixel = PIXMAN_FORMAT_BPP(surface_format(s));
+    int stride = surface_stride(s);
+    CGDataProviderRef provider = CGDataProviderCreateWithData(NULL, surface_data(s), stride * h, NULL);
+    CGImageRef image = CGImageCreate(w, h, DIV_ROUND_UP(bitsPerPixel, 8) * 2, bitsPerPixel, stride, colorspace,
+                                     kCGBitmapByteOrder32Little | kCGImageAlphaNoneSkipFirst, provider, NULL, 0,
+                                     kCGRenderingIntentDefault);
+
+    CGContextSetInterpolationQuality(ctx, zoom_interpolation ? kCGInterpolationLow : kCGInterpolationNone);
+    CGContextDrawImage(ctx, NSRectToCGRect([self bounds]), image);
+    CGImageRelease(image);
+    CGDataProviderRelease(provider);
+}
+
+/* The guest's picture changed size: the cursor's scale follows (called on the main thread) */
+- (void)updateGuestSize
+{
+    with_bql(^{
+        guestWidth = qemu_console_get_width(head->dcl.con, guestWidth);
+        guestHeight = qemu_console_get_height(head->dcl.con, guestHeight);
+        /* a display that came or went moves the ones after it */
+        cocoa_heads_update_ui_info_locked();
+    });
+    [self updateCursorLayout];
+    [self setNeedsDisplay:YES];
+}
+
+/* The output's size and place for the guest; 0 x 0 = disconnected (BQL held) */
+- (void)updateUIInfoLocked
+{
+    QemuUIInfo info = { 0 };
+
+    if (head->shown && [self window]) {
+        bool fullscreen = ([[self window] styleMask] & NSWindowStyleMaskFullScreen) != 0;
+        NSSize frameSize = fullscreen ? [[[self window] screen] frame].size : [self frame].size;
+        NSSize backing = [self convertSizeToBacking:frameSize];
+        CGFloat scale = [[self window] backingScaleFactor];
+        /* as the main window: whole logical pixels at Hyprland's scales */
+        uint32_t divisor = scale > 1.75 ? 2 : scale > 1.25 ? 3 : 1;
+        uint32_t refreshRate = cocoa_screen_refresh_rate([[self window] screen]);
+
+        info.width = MAX(divisor, (uint32_t)backing.width / divisor * divisor);
+        info.height = MAX(divisor, (uint32_t)backing.height / divisor * divisor);
+        info.width_mm = 10 * MIN(255, MAX(1, (int)lround(frameSize.width * 2.54 / 110.0)));
+        info.height_mm = 10 * MIN(255, MAX(1, (int)lround(frameSize.height * 2.54 / 110.0)));
+        info.xoff = cocoa_head_xoff(head);
+        info.yoff = 0;
+        if (refreshRate) {
+            qemu_console_listener_set_refresh(&head->dcl, MAX(1u, 1000000u / refreshRate));
+            info.refresh_rate = refreshRate;
+        }
+    }
+    qemu_console_set_ui_info(head->dcl.con, &info, TRUE);
+}
+
+- (void)updateUIInfo
+{
+    if (!allow_events) {
+        return;
+    }
+    with_bql(^{
+        [self updateUIInfoLocked];
+    });
+}
+
+- (void)updateCursorLayout
+{
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    if (cursor && guestWidth > 0 && guestHeight > 0) {
+        CGFloat sx = [self bounds].size.width / guestWidth;
+        CGFloat sy = [self bounds].size.height / guestHeight;
+        CGRect bounds = CGRectMake(0, 0, cursor->width * sx, cursor->height * sy);
+
+        [cursorLayer setBounds:bounds];
+        [cursorLayer setContentsScale:sx];
+        [cursorLayer setPosition:CGPointMake(mouseX * sx, (guestHeight - mouseY) * sy)];
+    }
+    [cursorLayer setHidden:!mouseOn || !cursor];
+    [CATransaction commit];
+}
+
+- (void)setMouseX:(int)x y:(int)y on:(bool)on
+{
+    mouseX = x;
+    mouseY = y;
+    mouseOn = on;
+    [self updateCursorLayout];
+}
+
+- (void)setCursor:(QEMUCursor *)given_cursor
+{
+    cursor_unref(cursor);
+    cursor = given_cursor;
+    if (!cursor) {
+        [self updateCursorLayout];
+        return;
+    }
+    cursor_ref(cursor);
+
+    CGDataProviderRef provider = CGDataProviderCreateWithData(NULL, cursor->data,
+                                                              cursor->width * cursor->height * 4, NULL);
+    CGImageRef image = CGImageCreate(cursor->width, cursor->height, 8, 32, cursor->width * 4, colorspace,
+                                     kCGBitmapByteOrder32Little | kCGImageAlphaFirst, provider, NULL, 0,
+                                     kCGRenderingIntentDefault);
+    CGDataProviderRelease(provider);
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    [cursorLayer setContents:(id)image];
+    [self updateCursorLayout];
+    [CATransaction commit];
+    CGImageRelease(image);
+}
+
+/* Pointer: grabbed as in the main window while it is over this one */
+- (void)mouseEntered:(NSEvent *)event
+{
+    if ([cocoaView isAbsoluteEnabled] && ![cocoaView isMouseGrabbed]) {
+        [cocoaView grabMouse];
+    }
+}
+
+- (void)mouseExited:(NSEvent *)event
+{
+    if ([cocoaView isAbsoluteEnabled] && [cocoaView isMouseGrabbed]) {
+        [cocoaView ungrabMouse];
+    }
+}
+
+- (void)sendPointer:(NSEvent *)event
+{
+    if (![cocoaView isAbsoluteEnabled]) {
+        return;
+    }
+    if (![cocoaView isMouseGrabbed]) {
+        [cocoaView grabMouse];
+    }
+
+    NSPoint p = [self convertPoint:[event locationInWindow] fromView:nil];
+    NSSize size = [self bounds].size;
+
+    if (size.width <= 0 || size.height <= 0) {
+        return;
+    }
+    with_bql(^{
+        int w = qemu_console_get_width(head->dcl.con, guestWidth);
+        int h = qemu_console_get_height(head->dcl.con, guestHeight);
+
+        cocoa_queue_abs(head->dcl.con, p.x * w / size.width, (size.height - p.y) * h / size.height, w, h);
+        qemu_input_event_sync();
+    });
+}
+
+- (void)sendButton:(InputButton)button down:(bool)down event:(NSEvent *)event
+{
+    if (![cocoaView isAbsoluteEnabled]) {
+        return;
+    }
+    [self sendPointer:event];
+    with_bql(^{
+        qemu_input_queue_btn(dcl.con, button, down);
+        qemu_input_event_sync();
+    });
+}
+
+- (void)mouseMoved:(NSEvent *)event { [self sendPointer:event]; }
+- (void)mouseDragged:(NSEvent *)event { [self sendPointer:event]; }
+- (void)rightMouseDragged:(NSEvent *)event { [self sendPointer:event]; }
+- (void)otherMouseDragged:(NSEvent *)event { [self sendPointer:event]; }
+- (void)mouseDown:(NSEvent *)event { [self sendButton:INPUT_BUTTON_LEFT down:true event:event]; }
+- (void)mouseUp:(NSEvent *)event { [self sendButton:INPUT_BUTTON_LEFT down:false event:event]; }
+- (void)rightMouseDown:(NSEvent *)event { [self sendButton:INPUT_BUTTON_RIGHT down:true event:event]; }
+- (void)rightMouseUp:(NSEvent *)event { [self sendButton:INPUT_BUTTON_RIGHT down:false event:event]; }
+- (void)otherMouseDown:(NSEvent *)event { [self sendButton:INPUT_BUTTON_MIDDLE down:true event:event]; }
+- (void)otherMouseUp:(NSEvent *)event { [self sendButton:INPUT_BUTTON_MIDDLE down:false event:event]; }
