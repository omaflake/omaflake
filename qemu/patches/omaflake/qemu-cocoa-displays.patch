+#ifdef CONFIG_OPENGL
+/* GL: the scanout's texture, else the surface's, scaled to the view (context current) */
+static void cocoa_head_gl_render(CocoaHead *h)
+{
+    NSSize size = [h->view convertSizeToBacking:[h->view frame].size];
+    GLint filter = qatomic_read(&zoom_interpolation) ? GL_LINEAR : GL_NEAREST;
+
+    glViewport(0, 0, size.width, size.height);
+    if (h->scanout_borrow) {
+        DisplayGLTexture texture = h->scanout_borrow(h->scanout_id);
+
+        glBindTexture(GL_TEXTURE_2D, texture.id);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+        qemu_gl_run_texture_blit(dgc.gls, texture.y_0_top);
+    } else if (h->surface && h->surface->texture) {
+        glBindTexture(GL_TEXTURE_2D, h->surface->texture);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+        surface_gl_render_texture(dgc.gls, h->surface);
+    } else {
+        glClearColor(0, 0, 0, 1);
+        glClear(GL_COLOR_BUFFER_BIT);
+    }
+    h->dirty = false;
+}
+
+static void cocoa_head_gl_update(DisplayChangeListener *dcl, int x, int y, int w, int h)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    with_gl_view_ctx(^{
+        surface_gl_update_texture(dgc.gls, hd->surface, x, y, w, h);
+    });
+    hd->dirty = true;
+}
+
+static void cocoa_head_gl_switch(DisplayChangeListener *dcl, DisplaySurface *new_surface)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    with_gl_view_ctx(^{
+        surface_gl_destroy_texture(dgc.gls, hd->surface);
+        surface_gl_create_texture(dgc.gls, new_surface);
+    });
+    cocoa_head_switch(dcl, new_surface);
+    hd->dirty = true;
+}
+
+static void cocoa_head_gl_refresh(DisplayChangeListener *dcl)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    qemu_console_hw_update(dcl->con);
+    if (!hd->dirty || !hd->shown) {
+        return;
+    }
+#ifdef CONFIG_EGL
+    if (hd->egl_surface) {
+        eglMakeCurrent(qemu_egl_display, hd->egl_surface, hd->egl_surface, gl_view_ctx);
+        cocoa_head_gl_render(hd);
+        eglSwapBuffers(qemu_egl_display, hd->egl_surface);
+        eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        return;
+    }
+#endif
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [[hd->view layer] setNeedsDisplay];
+    });
+}
+
+static void cocoa_head_gl_scanout_disable(DisplayChangeListener *dcl)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    hd->scanout_borrow = NULL;
+    hd->dirty = true;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [hd->view updateGuestSize];
+    });
+}
+
+static void cocoa_head_gl_scanout_texture(DisplayChangeListener *dcl, uint32_t backing_id,
+                                          DisplayGLTextureBorrower backing_borrow,
+                                          uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+    bool was_active = hd->scanout_borrow != NULL;
+
+    hd->scanout_id = backing_id;
+    hd->scanout_borrow = backing_borrow;
+    hd->dirty = true;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (!was_active || hd->view->guestWidth != (int)w || hd->view->guestHeight != (int)h) {
+            [hd->view updateGuestSize];
+        }
+    });
+}
+
+static void cocoa_head_gl_scanout_flush(DisplayChangeListener *dcl, uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+    cocoa_head_of(dcl)->dirty = true;
+}
+
+static const DisplayChangeListenerOps dcl_head_gl_ops = {
+    .dpy_name               = "cocoa-display-gl",
+    .dpy_gfx_update         = cocoa_head_gl_update,
+    .dpy_gfx_switch         = cocoa_head_gl_switch,
+    .dpy_gfx_check_format   = console_gl_check_format,
+    .dpy_refresh            = cocoa_head_gl_refresh,
+    .dpy_mouse_set          = cocoa_head_mouse_set,
+    .dpy_cursor_define      = cocoa_head_cursor_define,
+    .dpy_gl_scanout_disable = cocoa_head_gl_scanout_disable,
+    .dpy_gl_scanout_texture = cocoa_head_gl_scanout_texture,
+    .dpy_gl_update          = cocoa_head_gl_scanout_flush,
+};
+
+static bool cocoa_head_is_gl_dcl(DisplayChangeListener *dcl)
+{
+    return dcl->ops == &dcl_head_gl_ops;
+}
