+/* View -> a display's console: show its window again (and connect the output) */
+static bool cocoa_head_show(int index)
+{
+    for (int i = 0; i < nheads; i++) {
+        CocoaHead *h = heads[i];
+
+        if (h->index == index) {
+            h->shown = true;
+            [h->window makeKeyAndOrderFront:nil];
+            [h->view updateUIInfo];
+            return true;
+        }
+    }
+    return false;
+}
+
+/* 2D */
+static void cocoa_head_update(DisplayChangeListener *dcl, int x, int y, int w, int h)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [hd->view setNeedsDisplay:YES];
+    });
+}
+
+static void cocoa_head_switch(DisplayChangeListener *dcl, DisplaySurface *new_surface)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    hd->surface = new_surface;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [hd->view updateGuestSize];
+    });
+}
+
+static void cocoa_head_refresh(DisplayChangeListener *dcl)
+{
+    qemu_console_hw_update(dcl->con);
+}
+
+static void cocoa_head_mouse_set(DisplayChangeListener *dcl, int x, int y, bool on)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [hd->view setMouseX:x y:y on:on];
+    });
+}
