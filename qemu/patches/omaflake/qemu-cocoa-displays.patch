+/*
+ * omaflake: one window per further display. A GPU with more than one output
+ * (virtio-gpu max_outputs=N) has a graphic console per output; the main
+ * window shows the first, and each further one gets a window of its own that
+ * can be moved to another screen (or made full screen there). A shown window
+ * connects its output: the guest gets a monitor of the window's size,
+ * suggested right of the ones before it. Closing the window disconnects the
+ * output; View -> its console shows it again.
+ *
+ * The pointer is the one USB tablet. Positions are mapped onto the guest's
+ * whole desktop, which guests lay out left to right in output order by
+ * default (the suggested positions say the same), so a click lands where it
+ * was made in any window. Keys go to the guest from any window
+ * (QemuApplication sends every event to the main view first).
+ */
+#define COCOA_MAX_HEADS 15
+
+typedef struct CocoaHead CocoaHead;
+
+@interface QemuCocoaHeadView : NSView <NSWindowDelegate>
+{
+@public
+    CocoaHead *head;
+    CGColorSpaceRef colorspace;
+    CALayer *cursorLayer;
+    QEMUCursor *cursor;
+    int mouseX;
+    int mouseY;
+    bool mouseOn;
+    int guestWidth;
+    int guestHeight;
+}
+- (id)initWithFrame:(NSRect)frameRect head:(CocoaHead *)h cgl:(BOOL)cgl;
+- (void)updateUIInfoLocked;
+- (void)updateGuestSize;
+- (void)setMouseX:(int)x y:(int)y on:(bool)on;
+- (void)setCursor:(QEMUCursor *)given_cursor;
+@end
+
+struct CocoaHead {
+    DisplayChangeListener dcl;
+    int index;          /* the console's index */
+    int number;         /* the display's number as the window shows it: 2, 3, ... */
+    QemuCocoaHeadView *view;
+    NSWindow *window;
+    bool shown;
+    DisplaySurface *surface;
+#ifdef CONFIG_OPENGL
+    uint32_t scanout_id;
+    DisplayGLTextureBorrower scanout_borrow;
+    bool dirty;
+#ifdef CONFIG_EGL
+    EGLSurface egl_surface;
+#endif
+#endif
+};
+
+static CocoaHead *heads[COCOA_MAX_HEADS];
+
+/* The guest shows something on this display (it took the output) */
+static bool cocoa_head_active(CocoaHead *h)
+{
+    if (!h->shown) {
+        return false;
+    }
+#ifdef CONFIG_OPENGL
+    if (h->scanout_borrow) {
+        return true;
+    }
+#endif
+    return h->surface && !surface_is_placeholder(h->surface);
+}
+
+/* The left edge of a display on the guest's desktop: the widths before it */
+static int cocoa_head_xoff(CocoaHead *h)
+{
+    int x = qemu_console_get_width(dcl.con, 0);
+
+    for (int i = 0; i < nheads && heads[i] != h; i++) {
+        if (cocoa_head_active(heads[i])) {
+            x += qemu_console_get_width(heads[i]->dcl.con, 0);
+        }
+    }
+    return x;
+}
+
+/*
+ * An absolute position (x, y) on console con, whose picture is w x h, to the
+ * tablet: one display as before; with further displays, a position on the
+ * desktop made of all of them side by side.
+ */
+static void cocoa_queue_abs(QemuConsole *con, CGFloat x, CGFloat y, int w, int h)
+{
+    int total_w = con == dcl.con ? w : qemu_console_get_width(dcl.con, 0);
+    int total_h = con == dcl.con ? h : qemu_console_get_height(dcl.con, 0);
+    int xoff = 0;
+
+    for (int i = 0; i < nheads; i++) {
+        CocoaHead *hd = heads[i];
+        bool mine = hd->dcl.con == con;
+
+        if (!mine && !cocoa_head_active(hd)) {
+            continue;
+        }
+        if (mine) {
+            xoff = total_w;
+        }
+        total_w += mine ? w : qemu_console_get_width(hd->dcl.con, 0);
+        total_h = MAX(total_h, mine ? h : qemu_console_get_height(hd->dcl.con, 0));
+    }
+    if (total_w <= 0 || total_h <= 0) {
+        return;
+    }
+    qemu_input_queue_abs(dcl.con, INPUT_AXIS_X, xoff + x, 0, total_w);
+    qemu_input_queue_abs(dcl.con, INPUT_AXIS_Y, y, 0, total_h);
+}
+
+/* The screen's refresh rate in mHz, 0 when unknown (as the main window finds it) */
+static uint32_t cocoa_screen_refresh_rate(NSScreen *screen)
+{
+    NSDictionary *description = [screen deviceDescription];
+    CGDirectDisplayID display = [[description objectForKey:@"NSScreenNumber"] unsignedIntValue];
+    CVDisplayLinkRef displayLink;
+    uint32_t refreshRate = 0;
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    if (!CVDisplayLinkCreateWithCGDisplay(display, &displayLink)) {
+        CVTime period = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(displayLink);
+        CVDisplayLinkRelease(displayLink);
+        if (!(period.flags & kCVTimeIsIndefinite) &&
+            period.timeValue > 0 && period.timeScale > 0) {
+            refreshRate = (int64_t)1000 * period.timeScale / period.timeValue;
+        }
+    }
+#pragma clang diagnostic pop
+    if (!refreshRate && [screen maximumFramesPerSecond] > 0) {
+        refreshRate = (uint32_t)[screen maximumFramesPerSecond] * 1000;
+    }
+    return refreshRate;
+}
+
+static void cocoa_heads_update_ui_info_locked(void)
+{
+    for (int i = 0; i < nheads; i++) {
+        [heads[i]->view updateUIInfoLocked];
+    }
+}
+
+static CocoaHead *cocoa_head_of(DisplayChangeListener *dcl)
+{
+    return container_of(dcl, CocoaHead, dcl);
+}
