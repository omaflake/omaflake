+static void cocoa_head_cursor_define(DisplayChangeListener *dcl, QEMUCursor *c)
+{
+    CocoaHead *hd = cocoa_head_of(dcl);
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        BQL_LOCK_GUARD();
+        [hd->view setCursor:qemu_console_get_cursor(dcl->con)];
+    });
+}
+
+static const DisplayChangeListenerOps dcl_head_ops = {
+    .dpy_name          = "cocoa-display",
+    .dpy_gfx_update    = cocoa_head_update,
+    .dpy_gfx_switch    = cocoa_head_switch,
+    .dpy_refresh       = cocoa_head_refresh,
+    .dpy_mouse_set     = cocoa_head_mouse_set,
+    .dpy_cursor_define = cocoa_head_cursor_define,
+};
