+/*
+ * A window per further graphic console (on the main thread, from
+ * cocoa_display_init, after the GL context exists). A display's window opens
+ * on the screen of the same number when there is one, else next to the main
+ * window.
+ */
+static void cocoa_heads_init(void)
+{
+    NSRect frame = cocoa_initial_window_frame();
+    NSArray<NSScreen *> *screens = [NSScreen screens];
+    NSWindow *mainWindow = [cocoaView window];
+
+    for (int index = 0; nheads < COCOA_MAX_HEADS; index++) {
+        QemuConsole *con = qemu_console_lookup_by_index(index);
+        CocoaHead *h;
+        NSWindow *window;
+        bool cgl = false;
+
+        if (!con) {
+            break;
+        }
+        if (con == dcl.con || !qemu_console_is_graphic(con)) {
+            continue;
+        }
+
+        h = g_new0(CocoaHead, 1);
+        h->index = index;
+        h->number = nheads + 2;
+        h->dcl.ops = &dcl_head_ops;
+#ifdef CONFIG_OPENGL
+        if (display_opengl) {
+            h->dcl.ops = &dcl_head_gl_ops;
+#ifdef CONFIG_EGL
+            cgl = !egl_surface;
+#else
+            cgl = true;
+#endif
+        }
+#endif
+        h->view = [[QemuCocoaHeadView alloc] initWithFrame:frame head:h cgl:cgl];
+        window = [[NSWindow alloc] initWithContentRect:frame
+            styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskMiniaturizable |
+                      NSWindowStyleMaskClosable | NSWindowStyleMaskResizable
+            backing:NSBackingStoreBuffered defer:NO];
+        [window setReleasedWhenClosed:NO];
+        [window setAcceptsMouseMovedEvents:YES];
+        [window setCollectionBehavior:NSWindowCollectionBehaviorFullScreenPrimary];
+        [window setTitle:qemu_name ?
+            [NSString stringWithFormat:@"QEMU %s – Display %d", qemu_name, h->number] :
+            [NSString stringWithFormat:@"QEMU – Display %d", h->number]];
+        [window setContentView:h->view];
+        [window setDelegate:h->view];
+        if ((NSUInteger)(h->number - 1) < [screens count]) {
+            NSRect visible = [screens[h->number - 1] visibleFrame];
+            [window setFrameOrigin:NSMakePoint(NSMidX(visible) - NSWidth([window frame]) / 2,
+                                               NSMidY(visible) - NSHeight([window frame]) / 2)];
+        } else {
+            NSRect m = [mainWindow frame];
+            NSRect f = [window frame];
+            f.origin = NSMakePoint(NSMinX(m) + 32 * (h->number - 1), NSMinY(m) - 32 * (h->number - 1));
+            [window setFrame:[window constrainFrameRect:f toScreen:[mainWindow screen]] display:NO];
+        }
+        h->window = window;
+#if defined(CONFIG_OPENGL) && defined(CONFIG_EGL)
+        if (display_opengl && egl_surface) {
+            h->egl_surface = qemu_egl_init_surface(gl_view_ctx, [h->view layer]);
+            if (!h->egl_surface) {
+                error_report("(cocoa) no EGL surface for display %d", h->number);
+                exit(1);
+            }
+        }
+#endif
+        h->surface = qemu_console_surface(con);
+        h->shown = true;
+        heads[nheads++] = h;
+        qemu_console_register_listener(con, &h->dcl, h->dcl.ops);
+        [window orderFront:nil];
+    }
+    [mainWindow makeKeyAndOrderFront:nil];
+}
+
+static void cocoa_heads_cleanup(void)
+{
+    for (int i = 0; i < nheads; i++) {
+        qemu_console_unregister_listener(&heads[i]->dcl);
+    }
+}
