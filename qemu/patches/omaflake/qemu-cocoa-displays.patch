+/* Window: size and screen go to the guest; closing disconnects the output */
+- (void)windowChanged
+{
+#ifdef CONFIG_OPENGL
+    if (display_opengl) {
+        [[self layer] setContentsScale:[[self window] backingScaleFactor]];
+    }
+#endif
+    [self updateCursorLayout];
+    [self updateUIInfo];
+}
+
+- (void)windowDidResize:(NSNotification *)notification { [self windowChanged]; }
+- (void)windowDidChangeScreen:(NSNotification *)notification { [self windowChanged]; }
+- (void)windowDidChangeBackingProperties:(NSNotification *)notification { [self windowChanged]; }
+- (void)windowDidEnterFullScreen:(NSNotification *)notification { [self windowChanged]; }
+- (void)windowDidExitFullScreen:(NSNotification *)notification { [self windowChanged]; }
+
+- (void)windowDidBecomeKey:(NSNotification *)notification
+{
+    /* the main window let go of the pointer when it stopped being key */
+    if ([cocoaView isAbsoluteEnabled] && ![cocoaView isMouseGrabbed]) {
+        [cocoaView grabMouse];
+    }
+}
+
+- (BOOL)windowShouldClose:(id)sender
+{
+    [[self window] orderOut:nil];
+    head->shown = false;
+    [self updateUIInfo];
+    return NO;
+}
+@end
